# Bring-up options layered over defconfig. Nothing here belongs upstream.

# Reset on any hang, and never lose the log of it.
CONFIG_QCOM_WDT=y
CONFIG_WATCHDOG_SYSFS=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
# The rescue kernel is 4.19 and reads these zones, so keep them plain text.
# CONFIG_PSTORE_COMPRESS is not set
CONFIG_PANIC_TIMEOUT=0
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=1
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=1
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_MAGIC_SYSRQ=y

# Everything a board needs before userspace, with no modules to load.
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_DEBUG_FS=y
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_RTC_DRV_PM8XXX=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_SPI_QCOM_GENI=y
# TYPEC_QCOM_PMIC and DRM_SIMPLEDRM can only be built in if DRM is.
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y

# USB gadget mode, for the shell and network link that replace rescue.
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_QCOM_PMIC=y
CONFIG_REGULATOR_QCOM_USB_VBUS=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y

# Board sensors, so the battery and temperatures can be read from a module-free image.
CONFIG_IIO=y
CONFIG_QCOM_SPMI_ADC5=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_QCOM_SPMI_ADC_TM5=y

# Clock controllers the GPU's IOMMU and the display wait for. As modules, these leave the
# GPU IOMMU failing with a deferred probe timeout, since this image loads no modules.
CONFIG_SM_DISPCC_6115=y
CONFIG_SM_GPUCC_6115=y

# The microSD card that came with the phone is exFAT.
CONFIG_EXFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# So the panel's backlight chip can be read with i2c-tools.
CONFIG_I2C_CHARDEV=y

# Display, built in so that it takes over from simpledrm without needing modules.
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_14NM_PHY=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_AW99703=y
CONFIG_REGULATOR_QCOM_LCDB=y
CONFIG_DRM_PANEL_DJN_FT8009=y
# Both would otherwise hold DRM_MSM at =m, and this image has no way to load modules.
# SM6115 has neither block.
CONFIG_QCOM_LLCC=n
CONFIG_QCOM_OCMEM=n

# The video codec.
CONFIG_MEDIA_SUPPORT=y
CONFIG_VIDEO_QCOM_IRIS=y

# So that the interconnect and clock controllers reach sync_state.
CONFIG_QCOM_ICC_BWMON=y

# Remote processors and WiFi, built in like everything else here. Their firmware comes
# from the microSD image, so they are started by hand once that's mounted.
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_SYSMON=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_QCOM_PD_MAPPER=y
CONFIG_QCOM_RMTFS_MEM=y
CONFIG_RFKILL=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_ATH10K=y
CONFIG_ATH10K_SNOC=y
CONFIG_HW_RANDOM_QCOM=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_FW_LOADER_COMPRESS_XZ=y

# Bluetooth, on a serdev UART.
CONFIG_BT=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_QCA=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_EDT_FT5X06=y
CONFIG_TOUCHSCREEN_EDT_FT5X06_SPI=y
CONFIG_SPI=y
CONFIG_SPI_QCOM_GENI=y
CONFIG_INPUT_EVDEV=y
CONFIG_CHARGER_QCOM_SMB2=y

# Audio, built in since this image loads no modules: the ADSP's services, the machine driver, the
# pins of the DSP's own I/O block, and the speaker amplifier.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SOUNDWIRE=y
CONFIG_SOUNDWIRE_QCOM=y
CONFIG_QCOM_APR=y
CONFIG_SND_SOC_QCOM=y
CONFIG_SND_SOC_SM8250=y
CONFIG_PINCTRL_LPASS_LPI=y
CONFIG_PINCTRL_SM6115_LPASS_LPI=y
CONFIG_SND_SOC_AW882XX=y
# USB audio offload isn't on this phone, and its module would hold the machine driver back as one.
# CONFIG_SND_USB_AUDIO_QMI is not set
# CONFIG_SND_SOC_QDSP6_USB is not set

# The PMIC's vibrator and status LED.
CONFIG_INPUT_PM8XXX_VIBRATOR=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_LEDS_QCOM_LPG=y
CONFIG_QCOM_PBS=y
CONFIG_NVMEM_SPMI_SDAM=y
CONFIG_LEDS_CLASS_FLASH=y
CONFIG_LEDS_QCOM_FLASH=y
# To test cooling by writing a temperature instead of waiting for real heat.
CONFIG_THERMAL_EMULATION=y

# The codec on SoundWire behind the LPASS macros: microphones, earpiece and headset jack.
CONFIG_SM_LPASSCC_6115=y
CONFIG_SND_SOC_WCD937X_SDW=y
CONFIG_SND_SOC_LPASS_RX_MACRO=y
CONFIG_SND_SOC_LPASS_TX_MACRO=y
CONFIG_SND_SOC_LPASS_VA_MACRO=y

# Mobile data
CONFIG_QCOM_IPA=y
CONFIG_RMNET=y
CONFIG_QCOM_MOTOROLA_UNIT_INFO=y

# Testing system sleep. A device stuck in suspend panics, which reaches pstore, rather than
# leaving a phone that needs someone to come and reset it.
CONFIG_PM_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
CONFIG_EXPERT=y
CONFIG_DPM_WATCHDOG=y
CONFIG_DPM_WATCHDOG_TIMEOUT=30
CONFIG_DPM_WATCHDOG_WARNING_TIMEOUT=15
CONFIG_QCOM_STATS=y
CONFIG_QCOM_RPM_MASTER_STATS=y
