#!/usr/bin/env bash
# phssh: log in to the phone over WiFi, once tools/wifiup --join has run.
#
#   tools/phssh [command ...]
#
# The address comes from PHONE_IP, or from the phone itself over adb. Host keys aren't checked,
# because each new tools/mkroot image comes with a new one.
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
SSH_DIR=$ROOT/build/ssh
export ANDROID_SERIAL=${ANDROID_SERIAL:-<serial>}

ip=${PHONE_IP:-$(adb shell "chroot /r /bin/sh -lc 'ip -4 -o addr show wlan0'" | awk '{sub(/\/.*/, "", $4); print $4}')}

exec ssh -i "$SSH_DIR/id_ed25519" -o IdentitiesOnly=yes \
	-o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no -o LogLevel=ERROR \
	-o ConnectTimeout=8 "root@$ip" "$@"
