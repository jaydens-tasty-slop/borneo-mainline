# The runtime checks Documentation/process/submit-checklist.rst asks of new code, for
# BK_VARIANT=debug tools/bk. Much slower than the dev kernel: don't judge timing or power with it.

# "Has been tested with" these all at once
CONFIG_PREEMPT=y
CONFIG_DEBUG_PREEMPT=y
CONFIG_SLUB_DEBUG=y
CONFIG_SLUB_DEBUG_ON=y
CONFIG_DEBUG_PAGEALLOC=y
CONFIG_DEBUG_PAGEALLOC_ENABLE_DEFAULT=y
CONFIG_DEBUG_MUTEXES=y
CONFIG_DEBUG_SPINLOCK=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_PROVE_RCU=y
CONFIG_DEBUG_OBJECTS=y
CONFIG_DEBUG_OBJECTS_RCU_HEAD=y

# These tables live in BSS, and tools/bk refuses a kernel that runs into the first reserved
# region, so keep them only as big as they need to be.
# "All codepaths have been exercised with all lockdep features enabled"
CONFIG_PROVE_LOCKING=y
CONFIG_LOCK_STAT=n
CONFIG_DEBUG_LOCKDEP=y
CONFIG_LOCKDEP_BITS=16
CONFIG_LOCKDEP_CHAINS_BITS=16
CONFIG_LOCKDEP_STACK_TRACE_BITS=19

# Lifetime bugs the checklist names less directly
CONFIG_DEBUG_OBJECTS_WORK=y
CONFIG_DEBUG_OBJECTS_TIMERS=y
CONFIG_DEBUG_SHIRQ=y
CONFIG_DMA_API_DEBUG=y
CONFIG_DEBUG_KMEMLEAK=y
CONFIG_DEBUG_KMEMLEAK_MEM_POOL_SIZE=16000
CONFIG_DEBUG_DEVRES=y

# "Has been checked with injection of at least slab and page-allocation failures"
CONFIG_FAULT_INJECTION=y
CONFIG_FAULT_INJECTION_DEBUG_FS=y
CONFIG_FAILSLAB=y
CONFIG_FAIL_PAGE_ALLOC=y

# So the flash LED driver release path is compiled in
CONFIG_V4L2_FLASH_LED_CLASS=y
