#!/usr/bin/env python3
"""mkseries: cut linux/ borneo/dev into the upstream series listed in tools/series.list.

  tools/mkseries --check          every commit listed exactly once? No tree is touched.
  tools/mkseries [NAME ...]       build those series (default: all not on hold)
  tools/mkseries --all            build the held series too
  tools/mkseries --base REV ...   apply to REV instead of v7.4-rc1 (say next/master)
  tools/mkseries --build ...      also compile what each series touches, on its own

For each series, in a throwaway worktree: cherry-pick its commits alone onto the base, strip the
trailer upstream doesn't want, and write what comes out to build/series/NAME/ with checkpatch and
get_maintainer results, and tools/series.d/NAME as the cover letter. A local branch send/NAME is left in linux/ for the user to review and sign
off. Nothing is signed off and nothing is sent: that's the user's part.
"""
import argparse
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
LINUX = ROOT / "linux"
OUT = ROOT / "build" / "series"
WT = ROOT / "build" / "series-wt"
OBJ = ROOT / "build" / "series-obj"
LIST = ROOT / "tools" / "series.list"
NOTES = ROOT / "tools" / "series.d"
DEV = "borneo/dev"
RANGE_BASE = "v7.4-rc1"
ME = "Jayden Milne <linux@jayd.ml>"
# Upstream dropped these trailers in 1e035297ffda: tool use goes in the cover letter or changelog
# text. Only the line this project adds goes: what other authors wrote is theirs to change, and not
# every Assisted-by there is a tool.
STRIP = re.compile(r"^Co-Authored-By: Claude ", re.I)
TOOL_NOTE = """These patches were written with Claude Code (Claude Opus 5.5) while bringing up
the phone, and any problems they fix were found with it. It also ran the tests described."""
REVIEW_MARK = "*** Say what you reviewed and tested yourself, then delete this line ***"
IDENT = {
    "GIT_COMMITTER_NAME": "Jayden Milne",
    "GIT_COMMITTER_EMAIL": "linux@jayd.ml",
}


def git(*args, cwd=LINUX, check=True, env=None):
    e = dict(os.environ, **(env or {}))
    r = subprocess.run(["git", *args], cwd=cwd, env=e, text=True, capture_output=True)
    if check and r.returncode:
        sys.exit(f"git {' '.join(args)}: {r.stderr.strip()}")
    return r


def load():
    series, cur = {}, None
    for n, line in enumerate(LIST.read_text().splitlines(), 1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        word, _, rest = line.partition(" ")
        if word == "series":
            cur = series[rest] = {"name": rest, "hold": None, "needs": [], "subjects": []}
        elif cur is None:
            sys.exit(f"series.list:{n}: nothing before the first series")
        elif word == "hold":
            cur["hold"] = rest
        elif word == "needs":
            cur["needs"].append(rest)
        else:
            cur["subjects"].append(line)
    return series


def commits():
    out = git("log", "--reverse", "--format=%H%x00%s", f"{RANGE_BASE}..{DEV}").stdout
    return [tuple(line.split("\0", 1)) for line in out.splitlines()]


def check(series, log):
    """Every commit in exactly one series, every subject a real commit, in branch order."""
    bad = 0
    have = {}
    for h, s in log:
        if s in have:
            print(f"two commits share a subject: {s}")
            bad += 1
        have[s] = h
    order = {s: i for i, (_, s) in enumerate(log)}
    seen = {}
    for sr in series.values():
        last = -1
        for s in sr["subjects"]:
            if s not in have:
                print(f"{sr['name']}: no such commit: {s}")
                bad += 1
                continue
            if s in seen:
                print(f"{sr['name']}: already in {seen[s]}: {s}")
                bad += 1
            seen[s] = sr["name"]
            if order[s] < last:
                print(f"{sr['name']}: out of branch order: {s}")
            last = max(last, order[s])
        for n in sr["needs"]:
            if n not in series:
                print(f"{sr['name']}: needs unknown series {n}")
                bad += 1
    for s in have:
        if s not in seen:
            print(f"in no series: {s}")
            bad += 1
    return bad


def closure(series, name, done=None):
    done = [] if done is None else done
    for n in series[name]["needs"]:
        closure(series, n, done)
    if name not in done:
        done.append(name)
    return done


def strip_message(msg):
    lines = [ln for ln in msg.splitlines() if not STRIP.match(ln)]
    while lines and not lines[-1].strip():
        lines.pop()
    return "\n".join(lines) + "\n"


def pick(hash_, env):
    """Cherry-pick with the trailers gone. Returns an error text, or None."""
    r = git("cherry-pick", hash_, cwd=WT, check=False, env=env)
    if r.returncode:
        files = git("diff", "--name-only", "--diff-filter=U", cwd=WT, check=False).stdout.split()
        git("cherry-pick", "--abort", cwd=WT, check=False)
        # No conflicted file means an empty pick: the base already has this change.
        return "conflict in " + ", ".join(files) if files else "already in the base, or: " + r.stderr.strip()[:160]
    msg = strip_message(git("log", "-1", "--format=%B", cwd=WT).stdout)
    p = subprocess.run(["git", "commit", "--amend", "--no-verify", "-q", "-F", "-"],
                       cwd=WT, env=dict(os.environ, **env), input=msg, text=True, capture_output=True)
    if p.returncode:
        return "amend failed: " + p.stderr.strip()[:200]
    return None


def run_checks(d, patches):
    """checkpatch per patch; a missing Signed-off-by is expected here and counted apart."""
    env = dict(os.environ, PATH=os.path.expanduser("~/.local/bin") + ":" + os.environ["PATH"])
    report = []
    worst = 0
    for p in patches:
        r = subprocess.run(["scripts/checkpatch.pl", "--strict", "--no-summary", "--terse", str(p)],
                           cwd=WT, env=env, text=True, capture_output=True)
        lines = [ln.split(str(p) + ":", 1)[-1] for ln in r.stdout.splitlines() if ln.strip()]
        lines = [ln for ln in lines if "Missing Signed-off-by" not in ln]
        if lines:
            report.append(f"--- {p.name}")
            report += lines
            worst += sum(1 for ln in lines if "ERROR" in ln or "WARNING" in ln)
    (d / "checkpatch.txt").write_text("\n".join(report) + "\n")
    return worst


def run_maintainers(d, patches):
    r = subprocess.run(["scripts/get_maintainer.pl", "--no-rolestats", "--no-git-fallback", *map(str, patches)],
                       cwd=WT, text=True, capture_output=True)
    (d / "to-cc.txt").write_text(r.stdout)
    return len(r.stdout.splitlines())


def fill_cover(d, name):
    """Put tools/series.d/NAME in the cover letter: its first line is the subject.

    What the user reviewed is theirs to say, so that stays a marker they have to deal with.
    """
    cover = d / "0000-cover-letter.patch"
    text = NOTES / name
    if not cover.exists() or not text.exists():
        return
    subject, _, body = text.read_text().partition("\n")
    out = cover.read_text().replace("*** SUBJECT HERE ***", subject)
    out = out.replace("*** BLURB HERE ***", f"{body.strip()}\n\n{TOOL_NOTE}\n\n{REVIEW_MARK}")
    cover.write_text(out)


def run_build(d, patches):
    """Does this series compile with only what it needs? Touched files only, W=1, defconfig."""
    files = []
    for p in patches:
        for line in p.read_text(errors="replace").splitlines():
            if line.startswith("+++ b/"):
                files.append(line[6:])
    objs = sorted({f[:-2] + ".o" for f in files if f.endswith(".c")})
    yamls = sorted({f for f in files if f.endswith(".yaml") and "/bindings/" in f})
    dts = any(f.endswith((".dts", ".dtsi")) for f in files)
    env = dict(os.environ, PATH=os.path.expanduser("~/.local/bin") + ":" + os.environ["PATH"])
    make = ["make", f"O={OBJ}", "ARCH=arm64", "LLVM=1", "CC=ccache clang", f"-j{os.cpu_count()}", "-s"]
    log = []

    def step(*what, cmd=make):
        r = subprocess.run([*cmd, *what], cwd=WT, env=env, text=True, capture_output=True)
        log.append(f"$ make {' '.join(what)}\n{r.stdout}{r.stderr}")
        return r.returncode

    bad = step("defconfig")
    # A driver for another architecture only compiles there.
    riscv = [o for o in objs if "riscv" in o]
    if riscv:
        rv = [a.replace("arm64", "riscv").replace(str(OBJ), f"{OBJ}-riscv") for a in make]
        bad += step("defconfig", cmd=rv)
        for o in riscv:
            bad += bool(step("W=1", o, cmd=rv))
    for o in set(objs) - set(riscv):
        bad += bool(step("W=1", o))
    for y in yamls:
        bad += bool(step("dt_binding_check", f"DT_SCHEMA_FILES={Path(y).name}"))
    if dts:
        bad += bool(step("qcom/qrb4210-rb2.dtb", "qcom/sm4250-oneplus-billie2.dtb"))
    (d / "build.txt").write_text("\n".join(log))
    warn = sum("warning:" in chunk or "error:" in chunk for chunk in log)
    return f"build {'FAILED ' + str(bad) if bad else 'ok'} ({warn} steps with warnings)"


def build(series, name, base, log, do_build=False):
    sr = series[name]
    by_subject = {s: h for h, s in log}
    env = IDENT
    d = OUT / name
    shutil.rmtree(d, ignore_errors=True)
    d.mkdir(parents=True)

    git("checkout", "-q", "-f", "--detach", base, cwd=WT)
    git("clean", "-fdq", cwd=WT)
    for dep in closure(series, name)[:-1]:
        for s in series[dep]["subjects"]:
            err = pick(by_subject[s], env)
            if err:
                return f"prerequisite {dep}, {s}: {err}"
    start = git("rev-parse", "HEAD", cwd=WT).stdout.strip()
    for s in sr["subjects"]:
        err = pick(by_subject[s], env)
        if err:
            return f"{s}: {err}"
    git("branch", "-f", f"send/{name}", "HEAD", cwd=WT)
    n = len(sr["subjects"])
    args = ["format-patch", "-q", f"--from={ME}", f"--base={start}", "-o", str(d), f"{start}..HEAD"]
    if n > 1:
        args.insert(1, "--cover-letter")
    git(*args, cwd=WT)
    fill_cover(d, name)
    patches = sorted(p for p in d.glob("*.patch") if not p.name.startswith("0000-"))
    warned = run_checks(d, patches)
    people = run_maintainers(d, patches)
    built = f", {run_build(d, patches)}" if do_build else ""
    hold = f", HOLD: {sr['hold']}" if sr["hold"] else ""
    return f"{n} patches, checkpatch issues {warned}, {people} recipients{built}{hold}"


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--check", action="store_true")
    ap.add_argument("--all", action="store_true")
    ap.add_argument("--base", default=RANGE_BASE)
    ap.add_argument("--build", action="store_true")
    ap.add_argument("names", nargs="*")
    a = ap.parse_args()

    series = load()
    log = commits()
    bad = check(series, log)
    if a.check or bad:
        print(f"{len(log)} commits, {len(series)} series, {bad} problems")
        sys.exit(1 if bad else 0)

    names = a.names or [n for n, s in series.items() if a.all or not s["hold"]]
    for n in names:
        if n not in series:
            sys.exit(f"no series named {n}")
    git("worktree", "remove", "--force", str(WT), check=False)
    git("worktree", "prune", check=False)
    git("worktree", "add", "-q", "--detach", str(WT), a.base)
    try:
        for n in names:
            print(f"{n}: {build(series, n, a.base, log, a.build)}", flush=True)
    finally:
        git("worktree", "remove", "--force", str(WT), check=False)


if __name__ == "__main__":
    main()
